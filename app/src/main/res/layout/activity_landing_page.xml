<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:padding="15dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".scan_page">

    <LinearLayout
        android:orientation="vertical"
        android:gravity="center"
        android:padding="10dp"
        android:layout_weight="1"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:src="@drawable/exmob_icon"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_form"
        android:padding="20dp"
        android:layout_weight="1.3"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_gradient_blue"
        android:orientation="vertical">
        <TextView
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Masukan Kode Ujian"
            android:textColor="#FFFFFF"/>
        <TextView
            android:textSize="15sp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Masukan kode ujian untuk memulai"
            android:textColor="#FFFFFF"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:orientation="horizontal">
            <EditText
                android:id="@+id/txtKodeUjian"
                android:autofillHints="name"
                android:layout_weight="2.5"
                android:drawableStart="@drawable/book_24"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:layout_width="0dp"
                android:hint="Masukan kode"
                android:background="@drawable/form_kode"/>
            <RelativeLayout
                android:layout_width="15dp"
                android:layout_height="match_parent"/>
           <Button
               android:id="@+id/btnCari"
               android:layout_weight="1"
               android:layout_height="wrap_content"
               android:layout_width="0dp"
               android:text="Start"
               android:drawableStart="@drawable/outline_arrow_right_alt_24"
               android:backgroundTint="#00569B"/>
        </LinearLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="20dp"/>

        <Button
            android:id="@+id/btnScan"
            android:drawableStart="@drawable/baseline_qr_code_scanner_24"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Scan Kode"
            android:backgroundTint="#00569B"/>
        <Button
            android:id="@+id/btnPickImage"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Pilih Gambar"
            android:backgroundTint="#00569B"/>
    </LinearLayout>
</LinearLayout>